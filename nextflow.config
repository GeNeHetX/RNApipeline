// Analysis defaults. Execution settings belong in a separate site/project config.
params.single_end = false
params.routine = true
params.check_samples = false
params.check_md5 = false
params.star = true
params.fastqc = true
params.multiqc = true
params.kallisto = true
params.fcounts = true
params.gatk4 = false
params.samtools_depth = false
params.no_multimapped = false
params.deepvariant = false
params.mpileup = false
params.vep = false

params.sampleList = null
params.csvSample = null
params.sampleInputDir = null
params.outputdir = 'results'
params.runNumber = System.getenv('NF_RUN_NAME') ?: 'manual'
params.scriptDir = "${projectDir}/PrePostScripts"
params.ensembl_release = 107
params.ref = null
params.reference_root = null
params.md5 = null
params.bed = ''
params.vep_cache = null
params.vep_species = ''
params.modelckptdeepar = null
params.pval = 0.99
params.min_coverage = 3
params.nproc = 12
params.tmpdir = 'tmp'
params.picard = '/data/picard.jar'
params.gatk = '/data/gatk-4.2.5.0/gatk-package-4.2.5.0-local.jar'

params.FeatureCountStrand = 2
params.kallistoStrand = ' --rf-stranded '
params.alignIntronMax = 1000000
params.alignMatesGapMax = 1000000
params.limitOutSJcollapsed = 1000000
params.limitSjdbInsertNsj = 1000000
params.outFilterMultimapNmax = 10
params.winAnchorMultimapNmax = 50
params.alignSJoverhangMin = 15
params.alignSJDBoverhangMin = 1
params.alignIntronMin = 20
params.outFilterMatchNminOverLread = 0
params.outFilterScoreMinOverLread = 0.3
params.outFilterMismatchNmax = 33
params.outFilterMismatchNoverLmax = 0.33
params.limitBAMsortRAM = 60000000000
params.read_len = 120
params.read_sd = 20

// Legacy --ref no_ref mode. All reference inputs use the selected release.
params.fasta_ref = "https://ftp.ensembl.org/pub/release-${params.ensembl_release}/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz"
params.GTF = "https://ftp.ensembl.org/pub/release-${params.ensembl_release}/gtf/homo_sapiens/Homo_sapiens.GRCh38.${params.ensembl_release}.chr.gtf.gz"
params.cdna = "https://ftp.ensembl.org/pub/release-${params.ensembl_release}/fasta/homo_sapiens/cdna/Homo_sapiens.GRCh38.cdna.all.fa.gz"
params.known_vcf = "https://ftp.ensembl.org/pub/release-${params.ensembl_release}/variation/vcf/homo_sapiens/1000GENOMES-phase_3.vcf.gz"

// One tag contains native ARM64 and x86_64 builds of identical tool versions.
params.tool_container = 'genehetx/genehetx-rnaseq:1.8.0'
params.containers = [
    genehetx_rnaseq: params.tool_container,
    fastqc: params.tool_container,
    multiqc: params.tool_container,
    kallisto: params.tool_container,
    featurecounts: params.tool_container,
    vep: 'quay.io/biocontainers/ensembl-vep:113.2--pl5321h2a3209d_0'
]
process {
    container = params.containers.genehetx_rnaseq
    withName: fastqc { container = params.containers.fastqc }
    withName: multiqc { container = params.containers.multiqc }
    withName: 'KallistoPE|Kallisto_single_end' { container = params.containers.kallisto }
    withName: FCounts { container = params.containers.featurecounts }
    withName: 'Vep.*' { container = params.containers.vep }
}
