params.pipeline_version = '2.0.0'
// Workflow defaults and explicit task resource requests.
params.single_end = false
params.routine = true
params.check_samples = false
params.check_md5 = false
params.kallisto = true
params.aggregate = false
params.samtools_depth = false
params.no_multimapped = false
params.variant_calling = false
params.somalier = true
params.bcftools_max_depth = 100000
params.variant_min_base_quality = 13
params.variant_min_mapping_quality = 0
// Deprecated switches are defined so legacy attempts can be rejected cleanly.
params.star = null
params.fastqc = null
params.fcounts = null
params.multiqc = null
params.mpileup = null
params.vep = null

params.sampleList = null
params.csvSample = null
params.sampleInputDir = null
params.outputdir = System.getenv('NF_RUN_RESULTS_DIR') ?: 'results'
params.runNumber = System.getenv('NF_RUN_NAME') ?: 'manual'
params.scriptDir = "${projectDir}/PrePostScripts"
params.ensembl_release = 107
params.ref = null
params.reference_root = null
params.transcriptome = null
params.md5 = null
params.bed = ''
params.vep_species = ''
// bcftools call -m prior; default documented by bcftools is 1.1e-3.
params.bcftools_prior = 1.1e-3
params.tmpdir = 'tmp'
params.picard = '/data/picard.jar'
params.gatk = '/data/gatk-4.2.5.0/gatk-package-4.2.5.0-local.jar'
params.reference_build_threads = 6
params.reference_build_memory = 36.GB
params.reference_build_root = '/ref'
params.reference_name = null

// Every task gets finite resources. Override these in a cohort config when needed.
params.default_task_memory = 2.GB
params.max_threads = 6
params.max_star_memory = 36.GB
params.fastqc_memory = 12.GB
params.kallisto_memory = 6.GB
params.featurecounts_memory = 4.GB
params.aggregate_memory = 8.GB
params.mpileup_memory = 8.GB
params.vep_memory = 40.GB

params.FeatureCountStrand = 2
params.kallistoStrand = ' --rf-stranded '
params.alignIntronMax = 1000000
params.alignMatesGapMax = 1000000
params.limitOutSJcollapsed = 1000000
params.limitSjdbInsertNsj = 1000000
params.outFilterMultimapNmax = 10
params.winAnchorMultimapNmax = 50
params.alignSJoverhangMin = 15
params.alignSJDBoverhangMin = 1
params.alignIntronMin = 20
params.outFilterMatchNminOverLread = 0
params.outFilterScoreMinOverLread = 0.3
params.outFilterMismatchNmax = 33
params.outFilterMismatchNoverLmax = 0.33
params.fragment_length = 120
params.read_len = null // Legacy alias for single-end mean fragment length.
params.read_sd = 20

// Reference-builder inputs. mainRNAseq requires a prebuilt reference directory.
// FASTA, GTF, cDNA and VEP cache always use ensembl_release.
params.fasta_ref = null
params.GTF = null
params.cdna = null
params.known_vcf = null
params.vep_cache_version = null // Legacy overrides must match ensembl_release.
params.vep_cache_url = null

// Build this image from Docker/Docker_file_genehetx-rnaseq/Dockerfile before use.
params.tool_container = 'genehetx/genehetx-rnaseq:v2.0.0'
params.salmon_container = 'combinelab/salmon@sha256:accc5581f515e10834d9127e67c4803e0cc713f7812b9699d54ad99b66e48742'
params.containers = [
    genehetx_rnaseq: params.tool_container,
    fastqc: params.tool_container,
    kallisto: params.tool_container,
    featurecounts: params.tool_container,
    vep: "genehetx/genehetx-vep:${params.ensembl_release}"
]
process {
    cpus = 1
    memory = params.default_task_memory
    container = params.containers.genehetx_rnaseq
    withName: fastqc { container = params.containers.fastqc }
    withName: 'KallistoPE|Kallisto_single_end' { container = params.containers.kallisto }
    withName: FCounts { container = params.containers.featurecounts }
    withName: 'Vep.*|ValidateHotspots' { container = params.containers.vep }
    withName: DownloadReference { cpus = 1; memory = 4.GB }
}

params.hotspot_catalogue = "${projectDir}/reference/hotspots/catalogue.tsv"
params.transcript_overrides = null
params.somalier_sites_url = 'https://github.com/brentp/somalier/files/4566475/sites.hg38.rna.vcf.gz'
params.somalier_sites_sha256 = '901cb1c396460a94a69b21f7f20e51fd2d74ed33ee0857343784bc123f4aa0fa'
