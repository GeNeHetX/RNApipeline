// Use through nf-run, which supplies the Slurm/Apptainer/S3 site runtime.
// These are the two RNA-seq resource knobs most users need to change:
params.max_threads = 6           // STAR and Kallisto threads per sample
params.max_star_memory = 36.GB    // STAR alignment memory requested from Slurm
// STAR's BAM sort cap is in bytes; keep it below max_star_memory for the index/runtime.
// If STAR reports insufficient memory for BAM sorting, raise this and max_star_memory together.
params.star_sort_memory = 30000000000
params.limitBAMsortRAM = params.star_sort_memory
params.reference_root = "/ref"
params.outputdir = System.getenv('NF_RUN_RESULTS_DIR') ?: 'results'

process {
    cpus = 1
    memory = 4.GB
    disk = 20.GB
    errorStrategy = { task.exitStatus == 14 ? 'retry' : 'terminate' }
    maxRetries = 2
    withName: 'doSTAR|doOnlySTARnCount' {
        cpus = params.max_threads
        memory = params.max_star_memory
        disk = 300.GB
    }
    withName: buildref { cpus = params.max_threads; memory = 64.GB; disk = 300.GB }
    withName: FCounts { cpus = 8; memory = 8.GB; disk = 100.GB }
    withName: 'KallistoPE|Kallisto_single_end' { cpus = params.max_threads; memory = 16.GB; disk = 100.GB }
    withName: fastqc { cpus = 2; memory = 8.GB }
    withName: multiqc { cpus = 1; memory = 5.GB }
    withName: gatk_vc { cpus = 16; memory = 64.GB; disk = 200.GB }
    withName: samtools_index { cpus = 2; memory = 8.GB }
    withName: samtools_depth { cpus = 4; memory = 16.GB }
    withName: 'Vep.*' { cpus = 16; memory = 40.GB; disk = 200.GB }
}
