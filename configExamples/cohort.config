// Example for a reverse-stranded paired-end library. Set values from the
// sequencing protocol or strandedness preflight before processing a cohort.
params.single_end = false
params.FeatureCountStrand = 2
params.kallistoStrand = ' --rf-stranded '
params.ensembl_release = 107
params.kallisto = true
params.variant_calling = false // Runs bcftools mpileup followed by VEP; reference must include BED and VEP cache.
params.aggregate = false // Combined FeatureCounts matrices and STAR metrics; requires STAR and FeatureCounts.

// Optional per-run resource overrides (IAC defaults: 6 threads, 36 GB for STAR).
// params.max_threads = 6
// params.max_star_memory = 36.GB
