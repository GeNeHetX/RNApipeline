// Example for a reverse-stranded paired-end library. Set values from the
// sequencing protocol or strandedness preflight before processing a cohort.
params.single_end = false
params.FeatureCountStrand = 2
params.kallistoStrand = ' --rf-stranded '
params.ensembl_release = 107

