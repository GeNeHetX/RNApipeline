// RNApipeline settings for TOD/PAM. Run this through IAC nf-run with -c.
// /etc/nextflow/site.config owns Slurm, queues, scratch, Apptainer, caches,
// architecture handling, and the S3 endpoint. Keep only RNA-specific params
// and process resources here.

params.single_end = false
params.routine = true
params.check_samples = false
params.check_md5 = false

params.star = true
params.fastqc = true
params.multiqc = true
params.kallisto = true
params.fcounts = true
params.gatk4 = false
params.samtools_depth = false
params.no_multimapped = true
params.deepvariant = false
params.mpileup = false
params.vep = false

params.pipeline_id = "rnapipeline"
params.run_id = System.getenv("NF_RUN_NAME") ?: "manual"
params.runNumber = params.run_id
params.outputdir = "s3://process/rnapipeline/${params.run_id}"
params.sampleInputDir = "s3://raw/path/to/fastq"
params.csvSample = "${System.getenv('NF_RUN_DIR') ?: '.'}/metadata/samples.csv"
// RNApipeline stages this small controller-local resource directory through a
// local process before Slurm tasks consume individual helper scripts.
params.scriptDir = "${projectDir}/PrePostScripts"
params.ref = "/ref/ensembl_v107_GRCh38"
params.reference_manifest = "${params.ref}/reference_manifest.json"
params.kallisto_bin_dir = "/ref/tools/rnapipeline/v1.7.0/kallisto/0.51.1/bin"
params.bed = ""
params.md5 = "md5Tab.tsv" // Staged explicitly by Verify_md5 when routine=false.
params.check_process_outputs = false

params.FeatureCountStrand = 2
params.kallistoStrand = " --rf-stranded "
params.alignIntronMax = 1000000
params.alignMatesGapMax = 1000000
params.limitOutSJcollapsed = 1000000
params.limitSjdbInsertNsj = 1000000
params.outFilterMultimapNmax = 10
params.winAnchorMultimapNmax = 50
params.alignSJoverhangMin = 15
params.alignSJDBoverhangMin = 1
params.alignIntronMin = 20
params.outFilterMatchNminOverLread = 0
params.outFilterScoreMinOverLread = 0.3
params.outFilterMismatchNmax = 33
params.outFilterMismatchNoverLmax = 0.33
params.limitBAMsortRAM = 60000000000
params.read_len = 120
params.read_sd = 20
params.tmpdir = "tmp"
params.pval = 0.99
params.nproc = 12
params.min_coverage = 3
params.modelckptdeepar = "/ref/deepvariant/model"
params.vep_cache = "/ref/ensembl_v107_GRCh38/VEP"
params.vep_species = ""
params.picard = "/data/picard.jar"
params.gatk = "/data/gatk-4.2.5.0/gatk-package-4.2.5.0-local.jar"

params.containers = [
  genehetx_rnaseq: "docker://genehetx/genehetx-rnaseq:v1.6.1",
  fastqc: "docker://genehetx/genehetx-rnaseq:v1.6.1",
  multiqc: "docker://genehetx/genehetx-rnaseq:v1.6.1",
  kallisto: "host-wrapper:${params.kallisto_bin_dir}/kallisto",
  featurecounts: "docker://genehetx/genehetx-rnaseq:v1.6.1",
  // Upstream VEP is AMD64-only. Keep params.vep=false on PAM-only serving
  // runs; enable it only with the IAC amd64 profile in burst mode.
  vep: "docker://quay.io/biocontainers/ensembl-vep:113.2--pl5321h2a3209d_0"
]

process {
  errorStrategy = { task.exitStatus == 14 ? "retry" : "terminate" }
  maxRetries = 2

  withName: buildref {
    cpus = 16
    memory = 40.GB
    disk = 300.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: doSTAR {
    cpus = 12
    memory = 70.GB
    disk = 500.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: doOnlySTARnCount {
    cpus = 12
    memory = 70.GB
    disk = 500.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: FCounts {
    cpus = 16
    memory = 16.GB
    disk = 200.GB
    container = params.containers.featurecounts
  }
  withName: gatk_vc {
    cpus = 16
    memory = 64.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: samtools_index {
    cpus = 2
    memory = 8.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: samtools_depth {
    cpus = 4
    memory = 16.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: 'KallistoPE|Kallisto_single_end' {
    cpus = 12
    memory = 14.GB
    disk = 200.GB
    // The wrapper selects the SIF after Slurm has assigned the node.
    container = null
    beforeScript = 'export PATH=' + params.kallisto_bin_dir + ':$PATH'
  }
  withName: fastqc {
    cpus = 4
    memory = 8.GB
    container = params.containers.fastqc
  }
  withName: multiqc {
    cpus = 4
    memory = 10.GB
    disk = 100.GB
    container = params.containers.multiqc
  }
  withName: Create_md5 {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Verify_md5 {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Check_samples {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Check_process {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Write_summary {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Vep {
    cpus = 16
    memory = 40.GB
    disk = 500.GB
    container = params.containers.vep
  }
}
