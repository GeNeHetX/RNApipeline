// TOD/IAC site profile for running RNApipeline on the current TOD/PAM infrastructure.
// Override project-specific params such as csvSample, sampleInputDir, ref, bed, and runNumber
// from the command line or in a small per-run config.

params.single_end = false
params.routine = true
params.check_samples = false
params.check_md5 = false

params.star = true
params.fastqc = true
params.multiqc = true
params.kallisto = true
params.fcounts = true
params.gatk4 = false
params.samtools_depth = false
params.no_multimapped = true
params.deepvariant = false
params.mpileup = false
params.vep = false

params.runNumber = "test-run"
params.pipeline_id = "rnapipeline"
params.run_id = "manual"
params.outputdir = "s3://process/rnapipeline/${params.run_id}"
params.sampleInputDir = "s3://raw/path/to/fastq"
params.csvSample = "samlist.tod.csv"
params.scriptDir = "${projectDir}/PrePostScripts"
params.ref = "/ref/ensembl_v107_GRCh38"
params.reference_manifest = "${params.ref}/reference_manifest.json"
params.bed = ""
params.md5 = "md5Tab.tsv" // Staged explicitly by Verify_md5 when routine=false.
params.check_process_outputs = false

params.FeatureCountStrand = 2
params.kallistoStrand = " --rf-stranded "
params.alignIntronMax = 1000000
params.alignMatesGapMax = 1000000
params.limitOutSJcollapsed = 1000000
params.limitSjdbInsertNsj = 1000000
params.outFilterMultimapNmax = 10
params.winAnchorMultimapNmax = 50
params.alignSJoverhangMin = 15
params.alignSJDBoverhangMin = 1
params.alignIntronMin = 20
params.outFilterMatchNminOverLread = 0
params.outFilterScoreMinOverLread = 0.3
params.outFilterMismatchNmax = 33
params.outFilterMismatchNoverLmax = 0.33
params.limitBAMsortRAM = 60000000000
params.read_len = 120
params.read_sd = 20
params.tmpdir = "tmp"
params.pval = 0.99
params.nproc = 12
params.min_coverage = 3
params.modelckptdeepar = "/ref/deepvariant/model"
params.vep_cache = "/ref/ensembl_v107_GRCh38/VEP"
params.vep_species = ""
params.picard = "/data/picard.jar"
params.gatk = "/data/gatk-4.2.5.0/gatk-package-4.2.5.0-local.jar"

params.containers = [
  genehetx_rnaseq: "docker://genehetx/genehetx-rnaseq:v1.6.1",
  fastqc: "docker://quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0",
  multiqc: "docker://quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0",
  kallisto: "docker://quay.io/biocontainers/kallisto:0.51.1--heb0cbe2_0",
  featurecounts: "docker://nanozoo/subread:2.0.2--53f5da6",
  vep: "docker://quay.io/biocontainers/ensembl-vep:113.2--pl5321h2a3209d_0"
]

profiles {
  tod_pam_cpu {
  }

  tod_pam_gpu {
    process.queue = "pam_gpu"
    process.clusterOptions = "--exclusive"
  }

  tod_rna_burst {
    process.queue = "rna_burst"
  }
}

process {
  executor = "slurm"
  queue = "pam_cpu"
  scratch = "/srv/slurm/scratch"
  errorStrategy = { task.exitStatus == 14 ? "retry" : "terminate" }
  maxRetries = 2

  withName: buildref {
    cpus = 16
    memory = 40.GB
    disk = 300.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: doSTAR {
    cpus = 12
    memory = 70.GB
    disk = 500.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: FCounts {
    cpus = 16
    memory = 16.GB
    disk = 200.GB
    container = params.containers.featurecounts
  }
  withName: KallistoPE {
    cpus = 12
    memory = 14.GB
    disk = 200.GB
    container = params.containers.kallisto
  }
  withName: fastqc {
    cpus = 4
    memory = 8.GB
    container = params.containers.fastqc
  }
  withName: multiqc {
    cpus = 4
    memory = 10.GB
    disk = 100.GB
    container = params.containers.multiqc
  }
  withName: Create_md5 {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Verify_md5 {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Check_samples {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Check_process {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Write_summary {
    cpus = 1
    memory = 4.GB
    container = params.containers.genehetx_rnaseq
  }
  withName: Vep {
    cpus = 16
    memory = 40.GB
    disk = 500.GB
    container = params.containers.vep
  }
}

executor {
  name = "slurm"
  queueSize = 20
}

// The IAC nf-run launcher supplies the explicit per-run -work-dir.
// Do not define a global workDir here.

apptainer {
  enabled = true
  autoMounts = true
  ociAutoPull = true
  cacheDir = "/srv/slurm/scratch/.apptainer-cache"
  pullCacheDir = "/srv/slurm/scratch/.apptainer-cache/pull"
}

singularity.enabled = false
docker.enabled = false

def todAccessKeyFile = new File("/etc/nextflow/secrets/access_key")
def todSecretKeyFile = new File("/etc/nextflow/secrets/secret_key")

aws {
  client {
    endpoint = "https://tods3.genehetx.fr"
    s3PathStyleAccess = true
    accessKey = System.getenv("AWS_ACCESS_KEY_ID") ?: (todAccessKeyFile.exists() ? todAccessKeyFile.text.trim() : "")
    secretKey = System.getenv("AWS_SECRET_ACCESS_KEY") ?: (todSecretKeyFile.exists() ? todSecretKeyFile.text.trim() : "")
  }
}

report.enabled = true
timeline.enabled = true
